# Backend configuration. Copy to .env for local development.
# Production values are set in the host's dashboard, never committed.

APP_ENV=development

# Which DataProvider feeds the pipeline. The backend is deliberately not welded
# to synthetic data: SIMULATION today, MODBUS/OPCUA/MQTT/RECORDED later, without
# rewriting the business logic above it.
DATA_SOURCE=SIMULATION

# Exact origins allowed to call this API, comma-separated. Never "*".
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

DATABASE_URL=sqlite:///./data/pumpguard.db

HOST=0.0.0.0
PORT=8000

# Simulation tick rate (Hz) for telemetry pushed over the WebSocket. The
# vibration waveform is sampled far faster than this internally -- the two rates
# are deliberately independent, as they are on real acquisition hardware.
TELEMETRY_RATE_HZ=5

# Drop a visitor's simulation session after this long with no connection, so
# abandoned browser tabs do not accumulate in memory.
SESSION_IDLE_TIMEOUT_S=900
