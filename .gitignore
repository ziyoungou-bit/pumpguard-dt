# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/

# Node
node_modules/
dist/
dist-ssr/
.vite/
*.local

# Environment: real values never enter the repo. The .example files do.
.env
.env.*
!.env.example
!.env.production.example

# Runtime data. The historian database is regenerated by running the platform,
# and committing it would mean a recruiter's demo starts mid-run with someone
# else's fault history in the trends.
data/*.db
data/*.db-wal
data/*.db-shm
backend/data/

# Trained model artefacts are BUILD outputs, produced by `python -m app.ml.train`
# and rebuilt in the Docker image. Committing binaries makes the repo heavy and
# makes it impossible to tell which code produced the model in the tree.
models/*.joblib
models/*.pkl

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
