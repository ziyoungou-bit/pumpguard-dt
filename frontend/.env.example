# PumpGuard DT frontend configuration.
#
# Copy to `.env` (or set these in the deployment environment) to point the app at
# a backend. If they are absent the app falls back to localhost for local
# development, and if nothing answers there it replays the bundled recorded demo
# dataset rather than showing empty screens.

# REST base URL, no trailing slash. Endpoints are appended as /api/...
VITE_API_BASE_URL=http://localhost:8000

# Websocket base URL, no trailing slash. The realtime stream is /ws/realtime.
VITE_WS_URL=ws://localhost:8000

# Repository link used by the landing page buttons.
VITE_GITHUB_URL=https://github.com/
